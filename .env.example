# LLM Configuration
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
JUDGE_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434

# Embedding & Retrieval
EMBED_MODEL=all-MiniLM-L6-v2
TOP_K=4

# ChromaDB
CHROMA_PATH=http://localhost:8001
CHROMA_COLLECTION=acme_kb

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Attack Testing
CANARY_URL=http://secure-login-update.acme-phish.test/login

# Defense Controls (off|veritensor|on depending on control)
DEFENSE_INGESTION=off
DEFENSE_SPOTLIGHTING=off
DEFENSE_OUTPUT=off

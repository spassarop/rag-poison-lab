# LLM Configuration
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
JUDGE_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434
# Generation temperature. 0.0 = deterministic (reproducible measurements).
LLM_TEMPERATURE=0.0

# Embedding & Retrieval
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
TOP_K=6

# ChromaDB
CHROMA_PATH=http://localhost:8001
CHROMA_COLLECTION=cocina_kb

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Attack Testing
CANARY_URL=http://login-update.cocinacloud.test/login

# Defense Controls (start off; flip on to show red→green)
# DEFENSE_INGESTION: off | comma-set of {signatures, veritensor, anomaly}
#   e.g. "signatures,anomaly". signatures+veritensor catch overt/stealth; anomaly
#   (perplexity proxy) catches the non-fluent GASLITE passage.
DEFENSE_INGESTION=off
DEFENSE_SPOTLIGHTING=off          # off | on  (prompt datamarking)
DEFENSE_OUTPUT=off                # off | on  (scan answer for external URLs)
DEFENSE_SPOTLIGHTING=off
DEFENSE_OUTPUT=off
DEFENSE_RETRIEVAL_FILTER=off      # off | on  (customer role → only public chunks)

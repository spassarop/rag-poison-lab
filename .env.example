# LLM Configuration
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
JUDGE_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434
# Generation temperature. 0.0 = deterministic (reproducible measurements).
LLM_TEMPERATURE=0.0

# Embedding & Retrieval
EMBED_MODEL=all-MiniLM-L6-v2
TOP_K=6

# ChromaDB
CHROMA_PATH=http://localhost:8001
CHROMA_COLLECTION=cocina_kb

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Attack Testing
CANARY_URL=http://secure-login-update.cocina-cloud-phish.test/login

# Defense Controls (off|veritensor|on depending on control)
DEFENSE_INGESTION=off
DEFENSE_SPOTLIGHTING=off
DEFENSE_OUTPUT=off
